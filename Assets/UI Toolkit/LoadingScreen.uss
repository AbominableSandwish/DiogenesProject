.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: #0e0f12;
}

.panel {
    width: 700px;
    max-width: 92%;
    padding: 24px;
    border-radius: 14px;
    background-color: #171a20;
}

.title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 6px;
}

.step {
    font-size: 14px;
    color: #cfd6e6;
    margin-bottom: 14px;
}

.progress {
    height: 18px;
    margin-bottom: 14px;
}

.logsBox {
    height: 150px;
    padding: 12px;
    border-radius: 10px;
    background-color: #0f1116;
}

.logs {
    white-space: normal;
    color: #cfd6e6;
    font-size: 12px;
}