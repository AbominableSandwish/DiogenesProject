<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="root">
        <ui:VisualElement class="panel">
            <ui:Label name="title" class="title" text="Chargement..." />
            <ui:Label name="stepLabel" class="step" text="Préparation" />

            <ui:ProgressBar name="progressBar" class="progress" title="0%" value="0" />

            <ui:VisualElement class="logsBox">
                <ui:Label name="logsLabel" class="logs" text="" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>